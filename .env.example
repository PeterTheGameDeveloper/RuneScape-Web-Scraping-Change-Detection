# OSRS Wiki Change Detection Pipeline - Environment Configuration

# Storage Mode: "local" or "minio"
STORAGE_MODE=local

# Local Storage Path (when STORAGE_MODE=local)
DATA_DIR=./data

# MinIO Configuration (when STORAGE_MODE=minio)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=osrs-wiki-changes
MINIO_SECURE=false

# DuckDB
DUCKDB_PATH=./data/warehouse.duckdb

# Scraper Settings
SCRAPE_INTERVAL_MINUTES=15
RATE_LIMIT_REQUESTS_PER_SECOND=1
LOOKBACK_HOURS=1

# Alerting (optional)
ALERT_ON_FAILURE=true
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx
